<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic. The same Act after one amendment: section 2 reworded, section 4 inserted.
     Sections 1 and 3 are byte-identical to v1, so a per-provision timeline that reported
     them as changed would be reporting the amendment's blast radius, not the amendment. -->
<Legislation xmlns="http://www.legislation.gov.uk/namespaces/legislation">
  <ukm:Metadata xmlns:ukm="http://www.legislation.gov.uk/namespaces/metadata">
    <dc:title xmlns:dc="http://purl.org/dc/elements/1.1/">Measurement Standards Act</dc:title>
    <ukm:Number Value="7"/>
    <ukm:Year Value="2019"/>
    <ukm:EnactmentDate Date="2019-03-04"/>
    <dct:valid xmlns:dct="http://purl.org/dc/terms/">2024-01-01</dct:valid>
  </ukm:Metadata>
  <Body>
    <Part id="part-1">
      <Number>Part 1</Number>
      <Title>Preliminary</Title>
      <P1 id="section-1">
        <Pnumber>1</Pnumber>
        <P1para><Text>This Act establishes the standards by which measurements are made.</Text></P1para>
      </P1>
      <P1 id="section-2">
        <Pnumber>2</Pnumber>
        <P1para><Text>In this Act, "measurement" means a quantity determined by comparison with a published standard, and "standard" means one maintained under section 4.</Text></P1para>
      </P1>
    </Part>
    <Part id="part-2">
      <Number>Part 2</Number>
      <Title>Duties</Title>
      <P1 id="section-3">
        <Pnumber>3</Pnumber>
        <P1para><Text>A measuring authority must publish the standard it applies.</Text></P1para>
      </P1>
      <P1 id="section-4">
        <Pnumber>4</Pnumber>
        <P1para><Text>A measuring authority must maintain each standard it publishes and review it every five years.</Text></P1para>
      </P1>
    </Part>
  </Body>
</Legislation>
